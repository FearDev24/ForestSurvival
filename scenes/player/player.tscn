[gd_scene load_steps=10 format=3 uid="uid://bfsplayer0forest"]

[ext_resource type="Script" path="res://scripts/player/player.gd" id="1_player"]
[ext_resource type="Script" path="res://scripts/player/player_visual.gd" id="2_visual"]
[ext_resource type="SpriteFrames" uid="uid://bfsdruidaframes" path="res://assets/characters/druida_sprite_frames.tres" id="3_druida"]
[ext_resource type="Script" path="res://scripts/components/health_component.gd" id="4_health"]
[ext_resource type="Script" path="res://scripts/components/hurtbox_component.gd" id="5_hurtbox"]
[ext_resource type="Script" path="res://scripts/weapons/weapon_manager.gd" id="6_armas"]
[ext_resource type="Resource" uid="uid://bfsarmaraio" path="res://resources/weapons/cajado_raio.tres" id="7_raio"]
[ext_resource type="Resource" uid="uid://bfsarmavinha" path="res://resources/weapons/vinha_espinhosa.tres" id="8_vinha"]

[sub_resource type="CircleShape2D" id="CircleShape2D_body"]
radius = 14.0

[sub_resource type="CircleShape2D" id="CircleShape2D_hurt"]
radius = 16.0

[node name="Player" type="CharacterBody2D" groups=["player"]]
collision_layer = 1
collision_mask = 128
script = ExtResource("1_player")

[node name="Visual" type="Node2D" parent="."]
editor_description = "Unico ponto de troca de arte do Player. Asset atual em estado CANDIDATE: entra para avaliacao, nao e arte aprovada. Ver docs/ASSET_WORKFLOW.md e DEC-013. Nao adicionar logica de gameplay aqui."
script = ExtResource("2_visual")

[node name="Sprite" type="AnimatedSprite2D" parent="Visual"]
texture_filter = 1
position = Vector2(0, -48)
sprite_frames = ExtResource("3_druida")
animation = &"walk_south"

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
editor_description = "Colisao de gameplay, centrada nos pes. Dimensionada por criterio de movimento, nao pela arte. Nao redimensionar so porque a sprite mudou. Ver DEC-013."
shape = SubResource("CircleShape2D_body")

[node name="Health" type="Node" parent="."]
editor_description = "Vida do jogador. 100 de HP contra 10 por contato do diabrete: dez encostadas. Valor provisorio ate o sistema de Stats, na FASE 6."
script = ExtResource("4_health")
max_health = 100.0

[node name="Hurtbox" type="Area2D" parent="." node_paths=PackedStringArray("health")]
editor_description = "Recebe dano. Layer 3 PlayerHurtbox, mask 0: e detectavel, mas nao detecta ninguem. Quem procura e a hitbox do atacante."
collision_layer = 4
collision_mask = 0
monitoring = false
script = ExtResource("5_hurtbox")
health = NodePath("../Health")

[node name="CollisionShape2D" type="CollisionShape2D" parent="Hurtbox"]
position = Vector2(0, -24)
shape = SubResource("CircleShape2D_hurt")

[node name="WeaponManager" type="Node" parent="."]
editor_description = "Armas do druida. Nao implementa comportamento de arma nenhuma: cada arma e um WeaponData em resources/weapons. Acrescentar arma ao jogo e criar um .tres, nao escrever codigo (DEC-009, DEC-010)."
script = ExtResource("6_armas")
starting_weapons = Array[Resource]([ExtResource("7_raio"), ExtResource("8_vinha")])

[node name="Camera2D" type="Camera2D" parent="."]
position = Vector2(0, -40)

[connection signal="facing_changed" from="." to="Visual" method="set_facing"]
[connection signal="movement_state_changed" from="." to="Visual" method="set_moving"]
[connection signal="died" from="." to="Visual" method="play_death"]
[connection signal="death_animation_finished" from="Visual" to="." method="_on_visual_death_animation_finished"]
[connection signal="died" from="Health" to="." method="_on_health_died"]
