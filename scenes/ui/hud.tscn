anchor_left = 0.5
anchor_right = 0.5
offset_left = -520.0
offset_top = 16.0
offset_right = 520.0
offset_bottom = 109.0
grow_horizontal = 2
step = 0.01
value = 0.0
nine_patch_stretch = false
