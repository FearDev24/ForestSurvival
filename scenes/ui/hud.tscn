[node name="Hud" type="CanvasLayer"]
editor_description = "Painel da partida. layer 1: acima do mundo e abaixo do LevelUpMenu, que esta em 5. process_mode herdado de proposito, para o cronometro congelar junto com a partida quando a tela de escolha pausa o jogo."
layer = 1
script = ExtResource("1_hud")

[node name="BarraXp" type="TextureProgressBar" parent="."]
editor_description = "As texturas ja vem no tamanho de tela: o TextureProgressBar usa o tamanho da textura como minimo do controle, entao nao ha como encolher pelo size. Quem gera e tools/preparar_barras_hud.py. texture_filter LINEAR porque esta arte nao e pixel art - reduzi-la com NEAREST serrilha (excecao consciente a DEC-015, limitada ao HUD)."
