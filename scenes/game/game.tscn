[node name="Game" type="Node2D"]
y_sort_enabled = true
editor_description = "y_sort_enabled ordena as entidades pela coordenada Y: quem esta mais abaixo desenha na frente. Funciona porque a origem de Player e Enemy fica nos pes. O chao nao participa: World tem z_index -1, ou seja, uma camada abaixo."
script = ExtResource("1_game")

[node name="World" type="Node2D" parent="."]
z_index = -1
editor_description = "z_index -1 poe o cenario numa camada abaixo das entidades. Sem isso, o chao (origem em y=0) entraria na ordenacao por Y e o Player sumiria atras dele ao andar para cima."

[node name="TestWorld" parent="World" instance=ExtResource("2_world")]

[node name="Player" parent="." instance=ExtResource("3_player")]
position = Vector2(0, 0)

[node name="EnemyContainer" type="Node2D" parent="."]
y_sort_enabled = true
editor_description = "y_sort_enabled aqui faz os inimigos entrarem na mesma ordenacao do Player, em vez de serem desenhados como um bloco so."

[node name="ProjectileContainer" type="Node2D" parent="."]

[node name="PickupContainer" type="Node2D" parent="."]

[node name="EffectContainer" type="Node2D" parent="."]

[node name="SpawnManager" type="Node" parent="."]
editor_description = "Cria os inimigos da partida. Ligado ao Player, ao EnemyContainer e aos limites do mundo por scripts/systems/game.gd: o manager nao procura ninguem sozinho."
script = ExtResource("5_spawn")
enemy_scene = ExtResource("4_enemy")

[node name="RaioTeste" type="Node" parent="."]
editor_description = "Andaime de teste: dispara o raio sozinho para dar para ver a habilidade em jogo. Some quando o WeaponManager existir, na FASE 4 (DEC-009)."
script = ExtResource("6_caster")
strike_scene = ExtResource("7_strike")

[node name="GameOver" type="Sprite2D" parent="."]
editor_description = "Aparece no lugar onde o druida morreu, depois que a animacao de morte termina. z_index alto para ficar acima de tudo, fora da ordenacao por Y. Tela de game over de verdade, com botoes e restart, e da FASE 9."
visible = false
z_index = 100
scale = Vector2(0.28, 0.28)
texture = ExtResource("8_gameover")

[node name="CanvasLayer" type="CanvasLayer" parent="."]

[node name="RestartButton" type="Button" parent="CanvasLayer"]
editor_description = "Aparece junto com o game over. Recarrega a cena da partida. A tela de resultado completa - tempo, level, voltar ao menu - e da FASE 9."
visible = false
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -120.0
offset_top = -150.0
offset_right = 120.0
offset_bottom = -80.0
grow_horizontal = 2
grow_vertical = 0
theme_override_font_sizes/font_size = 30
text = "REINICIAR"

