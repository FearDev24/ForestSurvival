[node name="Game" type="Node2D"]
y_sort_enabled = true
editor_description = "y_sort_enabled ordena as entidades pela coordenada Y: quem esta mais abaixo desenha na frente. Funciona porque a origem de Player e Enemy fica nos pes. O chao nao participa: World tem z_index -1, ou seja, uma camada abaixo."
script = ExtResource("1_game")

[node name="World" type="Node2D" parent="."]
y_sort_enabled = true
editor_description = "y_sort_enabled propaga a ordenacao por Y ate os props e a borda, para o Player poder passar atras deles. Quem fica fora da ordenacao e o chao, pelo z_index negativo do proprio TileMapLayer."

[node name="TestWorld" parent="World" instance=ExtResource("2_world")]

[node name="Player" parent="." instance=ExtResource("3_player")]
position = Vector2(0, 0)

[node name="EnemyContainer" type="Node2D" parent="."]
y_sort_enabled = true
editor_description = "y_sort_enabled aqui faz os inimigos entrarem na mesma ordenacao do Player, em vez de serem desenhados como um bloco so."

[node name="ProjectileContainer" type="Node2D" parent="."]

[node name="PickupContainer" type="Node2D" parent="."]

[node name="EffectContainer" type="Node2D" parent="."]

[node name="SpawnManager" type="Node" parent="."]
editor_description = "Cria os inimigos da partida. Ligado ao Player, ao EnemyContainer e aos limites do mundo por scripts/systems/game.gd: o manager nao procura ninguem sozinho."
script = ExtResource("5_spawn")
enemy_scene = ExtResource("4_enemy")

[node name="WaveManager" type="Node" parent="."]
editor_description = "Tabela de waves (docs/03_SYSTEMS.md secao 7). Decide QUEM nasce e QUANDO; o SpawnManager decide ONDE e SE CABE. Enquanto este no existir, a rampa linear do SpawnManager fica desligada. Acrescentar uma wave e criar um .tres em resources/waves e por na lista aqui."
script = ExtResource("23_waves")
waves = Array[Resource]([ExtResource("24_w1"), ExtResource("25_w2"), ExtResource("26_w3"), ExtResource("27_w4"), ExtResource("28_w5")])

[node name="PickupSpawner" type="Node" parent="."]
editor_description = "Larga XP onde o inimigo morre. Separado do SpawnManager: criar inimigo e largar tesouro sao trabalhos diferentes, e a FASE 8 vai querer que o elite largue mais."
script = ExtResource("6_drop")
orb_scene = ExtResource("7_orb")

[node name="UpgradePool" type="Node" parent="."]
editor_description = "Catalogo do level up. Decide o que pode ser oferecido e o que a escolha faz; a tela so desenha. Acrescentar uma passiva ao jogo e criar um .tres em resources/upgrades e por na lista aqui - nao escrever codigo (DEC-010)."
script = ExtResource("11_pool")
catalogo = Array[Resource]([ExtResource("12_casca"), ExtResource("13_cervo"), ExtResource("14_essencia"), ExtResource("17_semente"), ExtResource("18_ciclo"), ExtResource("19_coracao"), ExtResource("15_raio"), ExtResource("16_vinha"), ExtResource("20_corvo"), ExtResource("21_esporo"), ExtResource("22_vagalume")])

[node name="Hud" parent="." instance=ExtResource("10_hud")]

[node name="LevelUpMenu" parent="." instance=ExtResource("9_levelup")]

[node name="GameOver" type="Sprite2D" parent="."]
editor_description = "Aparece no lugar onde o druida morreu, depois que a animacao de morte termina. z_index alto para ficar acima de tudo, fora da ordenacao por Y. Tela de game over de verdade, com botoes e restart, e da FASE 9."
visible = false
z_index = 100
scale = Vector2(0.28, 0.28)
texture = ExtResource("8_gameover")

[node name="CanvasLayer" type="CanvasLayer" parent="."]

[node name="RestartButton" type="Button" parent="CanvasLayer"]
editor_description = "Aparece junto com o game over. Recarrega a cena da partida. A tela de resultado completa - tempo, level, voltar ao menu - e da FASE 9."
visible = false
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -120.0
offset_top = -150.0
offset_right = 120.0
offset_bottom = -80.0
grow_horizontal = 2
grow_vertical = 0
theme_override_font_sizes/font_size = 30
text = "REINICIAR"

