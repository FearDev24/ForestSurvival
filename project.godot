; Forest Survival — survivor-like 2D top-down
; Engine oficial: Godot 4.7.2 stable (DEC-001)
; Alteracoes estruturais devem ser registradas em docs/DECISIONS.md

config_version=5

[application]

config/name="Forest Survival"
config/description="Survivor-like 2D top-down. Um druida guardiao defende a floresta de invasoes demoniacas."
run/main_scene="res://scenes/game/game.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

